# PayPal Sandbox browser SDK configuration.
# The client ID is public by design; never put PAYPAL_CLIENT_SECRET here.
VITE_PAYPAL_CLIENT_ID=
VITE_PAYPAL_SDK_URL=https://www.sandbox.paypal.com/web-sdk/v6/core

# Optional when the backend is not served through the Vite proxy.
# VITE_API_BASE=http://127.0.0.1:8080/api/v1
