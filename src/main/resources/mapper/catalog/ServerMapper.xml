<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.unicorn.gameshop.catalog.mapper.ServerMapper">
    <resultMap id="serverMap" type="com.unicorn.gameshop.catalog.model.Server">
        <id property="id" column="id"/>
        <result property="gameId" column="game_id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="region" column="region"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.unicorn.gameshop.catalog.model.Server">
        INSERT INTO servers (id, game_id, code, name, region, status, created_at, updated_at)
        VALUES (#{id}, #{gameId}, #{code}, #{name}, #{region}, #{status}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update" parameterType="com.unicorn.gameshop.catalog.model.Server">
        UPDATE servers SET game_id = #{gameId}, code = #{code}, name = #{name}, region = #{region},
                           status = #{status}, updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>

    <select id="findById" resultMap="serverMap">SELECT * FROM servers WHERE id = #{id}</select>
    <select id="list" resultMap="serverMap">
        SELECT * FROM servers
        <where>
            <if test="gameId != null and gameId != ''">game_id = #{gameId}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
        </where>
        ORDER BY created_at DESC
    </select>
</mapper>
