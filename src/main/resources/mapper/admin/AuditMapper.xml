<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.unicorn.gameshop.admin.service.AuditMapper">
    <insert id="insert">
        INSERT INTO audit_logs (id, operator_id, operator_username, action, resource_type, resource_id,
                                detail_json, created_at)
        VALUES (#{id}, #{operatorId}, #{operatorUsername}, #{action}, #{resourceType}, #{resourceId},
                #{detailJson}, #{createdAt})
    </insert>

    <resultMap id="auditMap" type="com.unicorn.gameshop.admin.model.AuditLog">
        <id property="id" column="id"/>
        <result property="operatorId" column="operator_id"/>
        <result property="operatorUsername" column="operator_username"/>
        <result property="action" column="action"/>
        <result property="resourceType" column="resource_type"/>
        <result property="resourceId" column="resource_id"/>
        <result property="detailJson" column="detail_json"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="listRecent" resultMap="auditMap">
        SELECT * FROM audit_logs ORDER BY created_at DESC LIMIT #{limit}
    </select>
</mapper>
